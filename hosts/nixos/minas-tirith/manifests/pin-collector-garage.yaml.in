# ---------------------------------------------------------------------------------------
# Garage: the S3 store that replaced MinIO (MinIO community edition was archived 2026-04-25;
# cut over 2026-09-28, docs/runbooks/minas-tirith/pin-collector-garage.md).
# Its durable objects carry objectset.rio.cattle.io/prune=false: k3s never deletes them
# because they left this file, so a stale or partial render cannot take the store's
# StatefulSet or claims with it. Removing one on purpose is an explicit kubectl delete.
# One node, replication 1; durability comes from fsync, the ZFS-backed nightly copy of
# /var/lib/rancher/k3s/storage, and the pelargir backup.
# ---------------------------------------------------------------------------------------
apiVersion: v1
kind: ConfigMap
metadata:
  name: garage-config
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
data:
  garage.toml: |
    metadata_dir = "/meta"
    data_dir = "/data"
    db_engine = "sqlite"
    # The strongest settings Garage offers: data blocks are fsynced; SQLite runs WAL with
    # synchronous=NORMAL, so a power loss can undo the last commits (never corrupt). Accepted
    # and bounded in docs/runbooks/minas-tirith/pin-collector-garage.md ("Durability").
    metadata_fsync = true
    data_fsync = true
    metadata_auto_snapshot_interval = "6h"
    replication_factor = 1
    rpc_bind_addr = "127.0.0.1:3901"
    rpc_public_addr = "127.0.0.1:3901"
    rpc_secret_file = "/run/secrets/pin-collector/garage-rpc-secret"
    # Garage wants secret files at 0600. Kubernetes projects them root-owned, 0440, group
    # = the pod's fsGroup: the only way a non-root pod reads them. Nothing outside this pod
    # can read that tmpfs, so the check is disabled rather than the files widened.
    allow_world_readable_secrets = true

    [s3_api]
    s3_region = "us-east-1"
    api_bind_addr = "0.0.0.0:3900"

    [admin]
    api_bind_addr = "0.0.0.0:3903"
    admin_token_file = "/run/secrets/pin-collector/garage-admin-token"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: garage-meta
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: garage-data
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 50Gi
---
# Clients: routes only to a ready (layout applied, healthy) Garage.
apiVersion: v1
kind: Service
metadata:
  name: garage
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  selector: { app: pin-collector-garage }
  ports:
    - { name: s3, port: 3900, targetPort: s3 }
---
# Bootstrap only: the admin API must be reachable before the node is ready, because
# readiness needs the layout the bootstrap applies.
apiVersion: v1
kind: Service
metadata:
  name: garage-admin
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector: { app: pin-collector-garage }
  ports:
    - { name: admin, port: 3903, targetPort: admin }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: garage-ingress
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  podSelector:
    matchLabels: { app: pin-collector-garage }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchExpressions:
              - key: app
                operator: In
                values:
                  - pin-collector-api
                  - pin-collector-migrate
                  - pin-collector-model-service
                  - pin-collector-training-pull
                  - pin-collector-garage-bootstrap
                  - pin-collector-backup
                  - pin-collector-storage-restore
      ports:
        - { protocol: TCP, port: 3900 }
    - from:
        - podSelector:
            matchLabels: { app: pin-collector-garage-bootstrap }
      ports:
        - { protocol: TCP, port: 3903 }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: garage
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  serviceName: garage-admin
  replicas: @statefulReplicas@
  selector:
    matchLabels: { app: pin-collector-garage }
  template:
    metadata:
      labels: { app: pin-collector-garage }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: garage
          image: dxflrs/garage:v2.3.0@sha256:866bd13ed2038ba7e7190e840482bc27234c4afaf77be8cfa439ae088c1e4690
          imagePullPolicy: IfNotPresent
          command: [/garage, -c, /etc/garage/garage.toml, server]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
            readOnlyRootFilesystem: true
          ports:
            - { name: s3, containerPort: 3900 }
            - { name: admin, containerPort: 3903 }
          resources:
            requests: { cpu: 100m, memory: 128Mi, ephemeral-storage: 64Mi }
            limits: { memory: 1Gi }
          # /health answers 200 only once the layout is applied and the node can serve.
          readinessProbe:
            httpGet: { path: /health, port: admin }
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            tcpSocket: { port: admin }
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - { name: config, mountPath: /etc/garage, readOnly: true }
            - { name: meta, mountPath: /meta }
            - { name: data, mountPath: /data }
            - { name: tmp, mountPath: /tmp }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: config
          configMap: { name: garage-config }
        - name: meta
          persistentVolumeClaim: { claimName: garage-meta }
        - name: data
          persistentVolumeClaim: { claimName: garage-data }
        - name: tmp
          emptyDir: { medium: Memory, sizeLimit: 16Mi }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: garage-rpc-secret, path: garage-rpc-secret, mode: 0440 }
              - { key: garage-admin-token, path: garage-admin-token, mode: 0440 }
---
# garage-bootstrap
apiVersion: v1
kind: ConfigMap
metadata:
  # Content-named, like the Job: a restarted Job never runs a newer script.
  name: @garageBootstrapConfigName@
  namespace: pin-collector
data:
  garage_bootstrap.py: |
@garageBootstrapScript@
---
# garage-bootstrap
# Named by a hash of these two documents and the API digest (manifest-renderers.nix): a
# changed script or spec renders a new Job, never an update to an immutable one.
apiVersion: batch/v1
kind: Job
metadata:
  name: @garageBootstrapJobName@
  namespace: pin-collector
spec:
  backoffLimit: 6
  suspend: @migrationSuspended@
  template:
    metadata:
      labels: { app: pin-collector-garage-bootstrap }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      imagePullSecrets:
        - { name: pin-collector-registry }
      enableServiceLinks: false
      automountServiceAccountToken: false
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: garage-bootstrap
          image: "@apiImage@"
          imagePullPolicy: IfNotPresent
          command: [python, /bootstrap/garage_bootstrap.py]
          env:
            # Must equal the garage-data claim (50Gi).
            - { name: GARAGE_CAPACITY_BYTES, value: "53687091200" }
            - { name: HOME, value: /tmp }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
            readOnlyRootFilesystem: true
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { memory: 512Mi }
          volumeMounts:
            - { name: script, mountPath: /bootstrap, readOnly: true }
            - { name: tmp, mountPath: /tmp }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: script
          configMap: { name: @garageBootstrapConfigName@ }
        - name: tmp
          emptyDir: { medium: Memory, sizeLimit: 16Mi }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: garage-admin-token, path: garage-admin-token, mode: 0440 }
              - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
              - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
              - { key: garage-backup-key-id, path: garage-backup-key-id, mode: 0440 }
              - { key: garage-backup-secret, path: garage-backup-secret, mode: 0440 }
