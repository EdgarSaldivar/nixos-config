# PinCollector Phase 1. Rendered by pelargir/manifests.nix only after
# pin-collector-release.nix enables a digest-pinned release.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-data
  namespace: pin-collector
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: minio-data
  namespace: pin-collector
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 10Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: model-cache
  namespace: pin-collector
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 30Gi
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: pin-collector
spec:
  clusterIP: None
  selector: { app: pin-collector-postgres }
  ports:
    - { name: postgres, port: 5432, targetPort: postgres }
---
apiVersion: v1
kind: Service
metadata:
  name: minio
  namespace: pin-collector
spec:
  selector: { app: pin-collector-minio }
  ports:
    - { name: api, port: 9000, targetPort: api }
---
apiVersion: v1
kind: Service
metadata:
  name: model-service
  namespace: pin-collector
spec:
  selector: { app: pin-collector-model-service }
  ports:
    - { name: http, port: 8000, targetPort: http }
    - { name: grpc, port: 8001, targetPort: grpc }
    - { name: metrics, port: 8002, targetPort: metrics }
---
apiVersion: v1
kind: Service
metadata:
  name: api
  namespace: pin-collector
spec:
  selector: { app: pin-collector-api }
  ports:
    - { name: http, port: 8000, targetPort: http }
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pin-collector-api-config
  namespace: pin-collector
data:
  PIN_COLLECTOR_ENVIRONMENT: production
  PIN_COLLECTOR_DATABASE_URL_FILE: /run/secrets/pin-collector/database-url
  PIN_COLLECTOR_OWNER_API_TOKEN_FILE: /run/secrets/pin-collector/owner-api-token
  PIN_COLLECTOR_ADMIN_API_TOKEN_FILE: /run/secrets/pin-collector/admin-api-token
  PIN_COLLECTOR_UPLOAD_S3_ACCESS_KEY_ID_FILE: /run/secrets/pin-collector/garage-app-key-id
  PIN_COLLECTOR_UPLOAD_S3_SECRET_ACCESS_KEY_FILE: /run/secrets/pin-collector/garage-app-secret
  PIN_COLLECTOR_BOOTSTRAP_ADMIN_EMAIL_FILE: /run/secrets/pin-collector/bootstrap-admin-email
  PIN_COLLECTOR_BOOTSTRAP_ADMIN_PASSWORD_FILE: /run/secrets/pin-collector/bootstrap-admin-password
  PIN_COLLECTOR_STORAGE_BACKEND: postgres
  PIN_COLLECTOR_RUN_MIGRATIONS_ON_STARTUP: "false"
  PIN_COLLECTOR_SEED_CATALOG_ON_STARTUP: "false"
  PIN_COLLECTOR_RECOGNITION_ADAPTER: triton
  PIN_COLLECTOR_PIN_CUTOUT_BACKEND: disabled
  PIN_COLLECTOR_TRITON_URL: http://model-service:8000
  PIN_COLLECTOR_UPLOAD_STORAGE_BACKEND: s3
  PIN_COLLECTOR_UPLOAD_S3_ENDPOINT_URL: http://garage:3900
  PIN_COLLECTOR_UPLOAD_S3_BUCKET: pin-collector-uploads
  PIN_COLLECTOR_UPLOAD_S3_REGION: us-east-1
  PIN_COLLECTOR_PUBLIC_API_BASE_URL: https://pin.saldivar.io
  PIN_COLLECTOR_ALLOWED_HOSTS: pin.saldivar.io,api.pin-collector.svc.cluster.local,localhost,127.0.0.1
  PIN_COLLECTOR_CORS_ALLOWED_ORIGINS: ""
  PIN_COLLECTOR_ADMIN_BASE_URL: https://pin.saldivar.io
  PIN_COLLECTOR_ADMIN_ALLOWED_HOSTS: pin.saldivar.io
  PIN_COLLECTOR_ADMIN_COOKIE_SECURE: "true"
  PIN_COLLECTOR_ADMIN_COOKIE_SAMESITE: lax
  PIN_COLLECTOR_ORPHANED_BLOB_REAPER_INTERVAL_SECONDS: "0"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pin-collector-migration-config
  namespace: pin-collector
data:
  PIN_COLLECTOR_ENVIRONMENT: production
  PIN_COLLECTOR_DATABASE_URL_FILE: /run/secrets/pin-collector/database-url
  PIN_COLLECTOR_STORAGE_BACKEND: postgres
  PIN_COLLECTOR_RECOGNITION_ADAPTER: triton
  PIN_COLLECTOR_PIN_CUTOUT_BACKEND: disabled
  PIN_COLLECTOR_UPLOAD_STORAGE_BACKEND: s3
  PIN_COLLECTOR_UPLOAD_S3_ENDPOINT_URL: http://garage:3900
  PIN_COLLECTOR_UPLOAD_S3_BUCKET: pin-collector-uploads
  PIN_COLLECTOR_UPLOAD_S3_REGION: us-east-1
  PIN_COLLECTOR_UPLOAD_S3_ACCESS_KEY_ID_FILE: /run/secrets/pin-collector/garage-app-key-id
  PIN_COLLECTOR_UPLOAD_S3_SECRET_ACCESS_KEY_FILE: /run/secrets/pin-collector/garage-app-secret
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: pin-collector-minio-policy
  namespace: pin-collector
data:
  policy.json: |
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads"],
          "Resource": ["arn:aws:s3:::pin-collector-uploads"]
        },
        {
          "Effect": "Allow",
          "Action": [
            "s3:AbortMultipartUpload",
            "s3:DeleteObject",
            "s3:GetObject",
            "s3:ListMultipartUploadParts",
            "s3:PutObject"
          ],
          "Resource": ["arn:aws:s3:::pin-collector-uploads/*"]
        }
      ]
    }
---
# Sensitive internal services accept only their explicit same-namespace clients.
# The public API remains reachable from the host-network Traefik instance.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: postgres-ingress
  namespace: pin-collector
spec:
  podSelector:
    matchLabels: { app: pin-collector-postgres }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchExpressions:
              - key: app
                operator: In
                values: [pin-collector-api, pin-collector-migrate, pin-collector-training-pull, pin-collector-backup]
      ports:
        - { protocol: TCP, port: 5432 }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: minio-ingress
  namespace: pin-collector
spec:
  podSelector:
    matchLabels: { app: pin-collector-minio }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchExpressions:
              - key: app
                operator: In
                values: [pin-collector-api, pin-collector-migrate, pin-collector-model-service, pin-collector-training-pull, pin-collector-storage-migrate]
      ports:
        - { protocol: TCP, port: 9000 }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: model-service-ingress
  namespace: pin-collector
spec:
  podSelector:
    matchLabels: { app: pin-collector-model-service }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels: { app: pin-collector-api }
      ports:
        - { protocol: TCP, port: 8000 }
        - { protocol: TCP, port: 8001 }
        - { protocol: TCP, port: 8002 }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: postgres
  namespace: pin-collector
spec:
  serviceName: postgres
  replicas: @statefulReplicas@
  selector:
    matchLabels: { app: pin-collector-postgres }
  template:
    metadata:
      labels: { app: pin-collector-postgres }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 120
      securityContext:
        runAsNonRoot: true
        runAsUser: 999
        runAsGroup: 999
        fsGroup: 999
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: postgres
          image: pgvector/pgvector@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          env:
            - { name: POSTGRES_DB, value: pin_collector }
            - { name: POSTGRES_USER, value: pin_collector }
            - { name: POSTGRES_PASSWORD_FILE, value: /run/secrets/pin-collector/postgres-password }
            # Initialize into a SUBDIRECTORY of the mount, never the mount point itself.
            # local-path creates the volume root owned by uid 0 and fsGroup only sets the
            # group, so initdb's chmod to 0700 fails with EPERM under Restricted Pod
            # Security (a non-root uid cannot chmod a root-owned directory). The container
            # creates and owns this subdirectory, because the setgid group-writable parent
            # lets uid 999 mkdir into it.
            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
          ports:
            - { name: postgres, containerPort: 5432 }
          resources:
            requests: { cpu: 250m, memory: 512Mi, ephemeral-storage: 256Mi }
            limits: { memory: 2Gi }
          startupProbe:
            exec: { command: [pg_isready, -U, pin_collector, -d, pin_collector] }
            periodSeconds: 5
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            exec: { command: [pg_isready, -U, pin_collector, -d, pin_collector] }
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            exec: { command: [pg_isready, -U, pin_collector, -d, pin_collector] }
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - { name: data, mountPath: /var/lib/postgresql/data }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: postgres-data }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: postgres-password, path: postgres-password, mode: 0440 }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: minio
  namespace: pin-collector
spec:
  serviceName: minio
  replicas: @statefulReplicas@
  selector:
    matchLabels: { app: pin-collector-minio }
  template:
    metadata:
      labels: { app: pin-collector-minio }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: minio
          image: minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
          imagePullPolicy: IfNotPresent
          command: [sh, -ec]
          args:
            - |
              export MINIO_ROOT_USER="$(cat /run/secrets/pin-collector/minio-root-user)"
              export MINIO_ROOT_PASSWORD="$(cat /run/secrets/pin-collector/minio-root-password)"
              exec minio server /data --console-address :9001
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          ports:
            - { name: api, containerPort: 9000 }
            - { name: console, containerPort: 9001 }
          resources:
            requests: { cpu: 100m, memory: 256Mi, ephemeral-storage: 256Mi }
            limits: { memory: 1Gi }
          startupProbe:
            httpGet: { path: /minio/health/ready, port: api }
            periodSeconds: 5
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /minio/health/ready, port: api }
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 6
          livenessProbe:
            httpGet: { path: /minio/health/live, port: api }
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - { name: data, mountPath: /data }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: data
          persistentVolumeClaim: { claimName: minio-data }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: minio-root-user, path: minio-root-user, mode: 0440 }
              - { key: minio-root-password, path: minio-root-password, mode: 0440 }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: model-service
  namespace: pin-collector
  annotations:
    pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
spec:
  replicas: @modelReplicas@
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: pin-collector-model-service }
  template:
    metadata:
      labels: { app: pin-collector-model-service }
      annotations:
        pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
        saldivar.io/gpu: nvidia
      runtimeClassName: nvidia
      imagePullSecrets:
        - { name: pin-collector-registry }
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 120
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: model-service
          image: "@modelImage@"
          imagePullPolicy: IfNotPresent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          env:
            - { name: HF_TOKEN_FILE, value: /run/secrets/pin-collector/hf-token }
            - { name: HF_HOME, value: /models-cache }
            - { name: PIN_COLLECTOR_DINO_MODEL_ID, value: facebook/dinov3-vitl16-pretrain-lvd1689m }
            - { name: PIN_COLLECTOR_MODEL_IMAGE_ROOTS, value: /app/seed-data }
            - { name: PIN_COLLECTOR_MODEL_ALLOWED_REMOTE_HOSTS, value: garage }
            - { name: PIN_COLLECTOR_PIN_PROCESSOR_REQUIRE_GPU, value: "1" }
            - { name: PIN_COLLECTOR_PIN_BATCH_PROCESSOR_FAKE_GPU, value: "0" }
          ports:
            - { name: http, containerPort: 8000 }
            - { name: grpc, containerPort: 8001 }
            - { name: metrics, containerPort: 8002 }
          resources:
            requests: { cpu: "2", memory: 8Gi, ephemeral-storage: 2Gi, nvidia.com/gpu: 1 }
            limits: { memory: 16Gi, nvidia.com/gpu: 1 }
          startupProbe:
            httpGet: { path: /v2/health/ready, port: http }
            periodSeconds: 10
            timeoutSeconds: 10
            failureThreshold: 90
          readinessProbe:
            httpGet: { path: /v2/health/ready, port: http }
            periodSeconds: 15
            timeoutSeconds: 10
            failureThreshold: 5
          livenessProbe:
            httpGet: { path: /v2/health/live, port: http }
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 5
          volumeMounts:
            - { name: model-cache, mountPath: /models-cache }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
            - { name: shm, mountPath: /dev/shm }
      volumes:
        - name: model-cache
          persistentVolumeClaim: { claimName: model-cache }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: hf-token, path: hf-token, mode: 0440 }
        - name: shm
          emptyDir: { medium: Memory, sizeLimit: 2Gi }
---
# Release-specific migration. Kubernetes Job pod templates
# are immutable, so the build-derived name changes whenever the API image does.
apiVersion: batch/v1
kind: Job
metadata:
  name: @migrationJobName@
  namespace: pin-collector
  annotations:
    pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
spec:
  backoffLimit: 20
  suspend: @migrationSuspended@
  template:
    metadata:
      labels: { app: pin-collector-migrate }
      annotations:
        pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      imagePullSecrets:
        - { name: pin-collector-registry }
      enableServiceLinks: false
      automountServiceAccountToken: false
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: migrate
          image: "@apiImage@"
          imagePullPolicy: IfNotPresent
          args:
            - python
            - -c
            - |
              from app.bootstrap import run_migrations
              from app.core.config import get_settings
              from app.storage.uploads import upload_storage_from_settings
              settings = get_settings()
              run_migrations(settings)
              upload_storage_from_settings(settings)
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          envFrom:
            - configMapRef: { name: pin-collector-migration-config }
          volumeMounts:
            - { name: migration-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: migration-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: database-url, path: database-url, mode: 0440 }
              - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
              - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api
  namespace: pin-collector
  annotations:
    pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
spec:
  replicas: @apiReplicas@
  strategy: { type: Recreate }
  selector:
    matchLabels: { app: pin-collector-api }
  template:
    metadata:
      labels: { app: pin-collector-api }
      annotations:
        pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      imagePullSecrets:
        - { name: pin-collector-registry }
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      initContainers:
        - name: require-migration-head
          image: "@apiImage@"
          imagePullPolicy: IfNotPresent
          args: [python, -m, alembic, current, --check-heads]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          envFrom:
            - configMapRef: { name: pin-collector-api-config }
          volumeMounts:
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      containers:
        - name: api
          image: "@apiImage@"
          imagePullPolicy: IfNotPresent
          args:
            - uvicorn
            - app.main:app
            - --host
            - 0.0.0.0
            - --port
            - "8000"
            - --proxy-headers
            - --forwarded-allow-ips
            - "*"
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
          envFrom:
            - configMapRef: { name: pin-collector-api-config }
          ports:
            - { name: http, containerPort: 8000 }
          resources:
            requests: { cpu: 500m, memory: 1Gi, ephemeral-storage: 512Mi }
            limits: { memory: 4Gi }
          startupProbe:
            httpGet: { path: /ready, port: http, httpHeaders: [{ name: Host, value: pin.saldivar.io }] }
            periodSeconds: 5
            timeoutSeconds: 5
            failureThreshold: 60
          readinessProbe:
            httpGet: { path: /ready, port: http, httpHeaders: [{ name: Host, value: pin.saldivar.io }] }
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 5
          livenessProbe:
            httpGet: { path: /health, port: http, httpHeaders: [{ name: Host, value: pin.saldivar.io }] }
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: database-url, path: database-url, mode: 0440 }
              - { key: owner-api-token, path: owner-api-token, mode: 0440 }
              - { key: admin-api-token, path: admin-api-token, mode: 0440 }
              - { key: bootstrap-admin-email, path: bootstrap-admin-email, mode: 0440 }
              - { key: bootstrap-admin-password, path: bootstrap-admin-password, mode: 0440 }
              - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
              - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
---
# Training-data pull: a Job created by hand from the suspended CronJob below
#   kubectl -n pin-collector create job --from=cronjob/training-pull training-pull-<stamp>
# It runs `python -m app.maintenance.training_pull` in the API image and writes the
# training archive on minas (storage2/pincollector/training), reached through a static
# local PersistentVolume: the namespace is Restricted, so no hostPath. Read-only against
# production; see PinCollector docs/runbooks/training-feedback-loop.md.
apiVersion: v1
kind: ConfigMap
metadata:
  name: pin-collector-training-pull-config
  namespace: pin-collector
data:
  # Only the secret files the pull needs are named here: the entrypoint refuses a
  # configured secret file it cannot read.
  PIN_COLLECTOR_ENVIRONMENT: production
  PIN_COLLECTOR_DATABASE_URL_FILE: /run/secrets/pin-collector/database-url
  PIN_COLLECTOR_UPLOAD_S3_ACCESS_KEY_ID_FILE: /run/secrets/pin-collector/garage-app-key-id
  PIN_COLLECTOR_UPLOAD_S3_SECRET_ACCESS_KEY_FILE: /run/secrets/pin-collector/garage-app-secret
  PIN_COLLECTOR_STORAGE_BACKEND: postgres
  PIN_COLLECTOR_RUN_MIGRATIONS_ON_STARTUP: "false"
  PIN_COLLECTOR_SEED_CATALOG_ON_STARTUP: "false"
  PIN_COLLECTOR_RECOGNITION_ADAPTER: triton
  PIN_COLLECTOR_PIN_CUTOUT_BACKEND: disabled
  PIN_COLLECTOR_UPLOAD_STORAGE_BACKEND: s3
  PIN_COLLECTOR_UPLOAD_S3_ENDPOINT_URL: http://garage:3900
  PIN_COLLECTOR_UPLOAD_S3_BUCKET: pin-collector-uploads
  PIN_COLLECTOR_UPLOAD_S3_REGION: us-east-1
  PIN_COLLECTOR_TRAINING_FEEDBACK_ROOT: /feedback
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: pin-collector-training-feedback
spec:
  capacity: { storage: 1Ti }
  accessModes: [ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: pin-collector-training
  volumeMode: Filesystem
  claimRef: { namespace: pin-collector, name: training-feedback }
  local:
    path: /storage2/pincollector/training/feedback
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - { key: kubernetes.io/hostname, operator: In, values: [minas-tirith] }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: training-feedback
  namespace: pin-collector
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: pin-collector-training
  volumeName: pin-collector-training-feedback
  resources:
    requests: { storage: 1Ti }
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: training-pull
  namespace: pin-collector
  annotations:
    pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
spec:
  # Suspended for good: this is only the template a hand-started Job is created from.
  suspend: true
  schedule: "0 0 31 2 *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 7200
      ttlSecondsAfterFinished: 1209600
      template:
        metadata:
          labels: { app: pin-collector-training-pull }
          annotations:
            pin-collector.saldivar.io/expected-image-revision: "@gitRevision@"
        spec:
          restartPolicy: Never
          nodeSelector:
            kubernetes.io/hostname: minas-tirith
          imagePullSecrets:
            - { name: pin-collector-registry }
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            # The Secret files are 0440; fsGroup makes them readable to the pod, as for
            # the API. It also applies to the archive volume: minas prepares that root as
            # 10001, group-writable and setgid, so OnRootMismatch leaves the tree alone.
            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile: { type: RuntimeDefault }
          containers:
            - name: training-pull
              image: "@apiImage@"
              imagePullPolicy: IfNotPresent
              args: [python, -m, app.maintenance.training_pull]
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: { drop: [ALL] }
              envFrom:
                - configMapRef: { name: pin-collector-training-pull-config }
              resources:
                requests: { cpu: 250m, memory: 512Mi, ephemeral-storage: 256Mi }
                limits: { memory: 2Gi }
              volumeMounts:
                - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
                - { name: feedback, mountPath: /feedback }
          volumes:
            - name: runtime-secret
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: database-url, path: database-url, mode: 0440 }
                  - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
                  - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
            - name: feedback
              persistentVolumeClaim: { claimName: training-feedback }
---
# ---------------------------------------------------------------------------------------
# Garage: the S3 store that replaced MinIO (MinIO community edition was archived 2026-04-25;
# cut over 2026-09-28, docs/runbooks/minas-tirith/pin-collector-garage.md).
# Its durable objects carry objectset.rio.cattle.io/prune=false: k3s never deletes them
# because they left this file, so a stale or partial render cannot take the store's
# StatefulSet or claims with it. Removing one on purpose is an explicit kubectl delete.
# One node, replication 1; durability comes from fsync, the ZFS-backed nightly copy of
# /var/lib/rancher/k3s/storage, and the pelargir backup.
# ---------------------------------------------------------------------------------------
apiVersion: v1
kind: ConfigMap
metadata:
  name: garage-config
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
data:
  garage.toml: |
    metadata_dir = "/meta"
    data_dir = "/data"
    db_engine = "sqlite"
    # The strongest settings Garage offers: data blocks are fsynced; SQLite runs WAL with
    # synchronous=NORMAL, so a power loss can undo the last commits (never corrupt). Accepted
    # and bounded in docs/runbooks/minas-tirith/pin-collector-garage.md ("Durability").
    metadata_fsync = true
    data_fsync = true
    metadata_auto_snapshot_interval = "6h"
    replication_factor = 1
    rpc_bind_addr = "127.0.0.1:3901"
    rpc_public_addr = "127.0.0.1:3901"
    rpc_secret_file = "/run/secrets/pin-collector/garage-rpc-secret"
    # Garage wants secret files at 0600. Kubernetes projects them root-owned, 0440, group
    # = the pod's fsGroup: the only way a non-root pod reads them. Nothing outside this pod
    # can read that tmpfs, so the check is disabled rather than the files widened.
    allow_world_readable_secrets = true

    [s3_api]
    s3_region = "us-east-1"
    api_bind_addr = "0.0.0.0:3900"

    [admin]
    api_bind_addr = "0.0.0.0:3903"
    admin_token_file = "/run/secrets/pin-collector/garage-admin-token"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: garage-meta
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 2Gi
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: garage-data
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: local-path-retain
  resources:
    requests:
      storage: 50Gi
---
# Clients: routes only to a ready (layout applied, healthy) Garage.
apiVersion: v1
kind: Service
metadata:
  name: garage
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  selector: { app: pin-collector-garage }
  ports:
    - { name: s3, port: 3900, targetPort: s3 }
---
# Bootstrap only: the admin API must be reachable before the node is ready, because
# readiness needs the layout the bootstrap applies.
apiVersion: v1
kind: Service
metadata:
  name: garage-admin
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector: { app: pin-collector-garage }
  ports:
    - { name: admin, port: 3903, targetPort: admin }
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: garage-ingress
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  podSelector:
    matchLabels: { app: pin-collector-garage }
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchExpressions:
              - key: app
                operator: In
                values:
                  - pin-collector-api
                  - pin-collector-migrate
                  - pin-collector-model-service
                  - pin-collector-training-pull
                  - pin-collector-storage-migrate
                  - pin-collector-garage-bootstrap
                  - pin-collector-backup
      ports:
        - { protocol: TCP, port: 3900 }
    - from:
        - podSelector:
            matchLabels: { app: pin-collector-garage-bootstrap }
      ports:
        - { protocol: TCP, port: 3903 }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: garage
  namespace: pin-collector
  labels: { objectset.rio.cattle.io/prune: "false" }
spec:
  serviceName: garage-admin
  replicas: @statefulReplicas@
  selector:
    matchLabels: { app: pin-collector-garage }
  template:
    metadata:
      labels: { app: pin-collector-garage }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      enableServiceLinks: false
      automountServiceAccountToken: false
      terminationGracePeriodSeconds: 60
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: garage
          image: dxflrs/garage:v2.3.0@sha256:866bd13ed2038ba7e7190e840482bc27234c4afaf77be8cfa439ae088c1e4690
          imagePullPolicy: IfNotPresent
          command: [/garage, -c, /etc/garage/garage.toml, server]
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
            readOnlyRootFilesystem: true
          ports:
            - { name: s3, containerPort: 3900 }
            - { name: admin, containerPort: 3903 }
          resources:
            requests: { cpu: 100m, memory: 128Mi, ephemeral-storage: 64Mi }
            limits: { memory: 1Gi }
          # /health answers 200 only once the layout is applied and the node can serve.
          readinessProbe:
            httpGet: { path: /health, port: admin }
            periodSeconds: 10
            timeoutSeconds: 5
            failureThreshold: 3
          livenessProbe:
            tcpSocket: { port: admin }
            initialDelaySeconds: 10
            periodSeconds: 30
            timeoutSeconds: 5
            failureThreshold: 5
          volumeMounts:
            - { name: config, mountPath: /etc/garage, readOnly: true }
            - { name: meta, mountPath: /meta }
            - { name: data, mountPath: /data }
            - { name: tmp, mountPath: /tmp }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: config
          configMap: { name: garage-config }
        - name: meta
          persistentVolumeClaim: { claimName: garage-meta }
        - name: data
          persistentVolumeClaim: { claimName: garage-data }
        - name: tmp
          emptyDir: { medium: Memory, sizeLimit: 16Mi }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: garage-rpc-secret, path: garage-rpc-secret, mode: 0440 }
              - { key: garage-admin-token, path: garage-admin-token, mode: 0440 }
---
# garage-bootstrap
apiVersion: v1
kind: ConfigMap
metadata:
  # Content-named, like the Job: a restarted Job never runs a newer script.
  name: @garageBootstrapConfigName@
  namespace: pin-collector
data:
  garage_bootstrap.py: |
@garageBootstrapScript@
---
# garage-bootstrap
# Named by a hash of these two documents and the API digest (manifest-renderers.nix): a
# changed script or spec renders a new Job, never an update to an immutable one.
apiVersion: batch/v1
kind: Job
metadata:
  name: @garageBootstrapJobName@
  namespace: pin-collector
spec:
  backoffLimit: 6
  suspend: @migrationSuspended@
  template:
    metadata:
      labels: { app: pin-collector-garage-bootstrap }
    spec:
      nodeSelector:
        kubernetes.io/hostname: minas-tirith
      imagePullSecrets:
        - { name: pin-collector-registry }
      enableServiceLinks: false
      automountServiceAccountToken: false
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        fsGroupChangePolicy: OnRootMismatch
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: garage-bootstrap
          image: "@apiImage@"
          imagePullPolicy: IfNotPresent
          command: [python, /bootstrap/garage_bootstrap.py]
          env:
            # Must equal the garage-data claim (50Gi).
            - { name: GARAGE_CAPACITY_BYTES, value: "53687091200" }
            - { name: HOME, value: /tmp }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: { drop: [ALL] }
            readOnlyRootFilesystem: true
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { memory: 512Mi }
          volumeMounts:
            - { name: script, mountPath: /bootstrap, readOnly: true }
            - { name: tmp, mountPath: /tmp }
            - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
      volumes:
        - name: script
          configMap: { name: @garageBootstrapConfigName@ }
        - name: tmp
          emptyDir: { medium: Memory, sizeLimit: 16Mi }
        - name: runtime-secret
          secret:
            secretName: pin-collector-runtime
            defaultMode: 0440
            items:
              - { key: garage-admin-token, path: garage-admin-token, mode: 0440 }
              - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
              - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
              - { key: garage-backup-key-id, path: garage-backup-key-id, mode: 0440 }
              - { key: garage-backup-secret, path: garage-backup-secret, mode: 0440 }
---
# Hand-started copy + verify between MinIO and Garage (cutover and rollback). Always create
# the Job under the one fixed name, which is the lock: the API server refuses a second Job
# of that name, so the two directions can never run at once.
#   kubectl -n pin-collector create job --from=cronjob/storage-migrate-minio-to-garage storage-migrate
# Stages: sync (rclone) → compare (Python) → repair + byte check (rclone) → verify (Python).
apiVersion: v1
kind: ConfigMap
metadata:
  # Content-named: every stage of one run reads the same script revision.
  name: @storageToolsConfigName@
  namespace: pin-collector
data:
  remotes.sh: |
    # Sourced. Builds both rclone remotes from mounted secret files, inside this shell only:
    # nothing on argv, nothing in the Pod spec.
    set -eu
    set +x
    export HOME=/tmp RCLONE_CONFIG=/tmp/rclone.conf
    : > "$RCLONE_CONFIG"
    export RCLONE_CONFIG_MINIO_TYPE=s3 RCLONE_CONFIG_MINIO_PROVIDER=Minio
    export RCLONE_CONFIG_MINIO_ENDPOINT=http://minio:9000 RCLONE_CONFIG_MINIO_REGION=us-east-1
    RCLONE_CONFIG_MINIO_ACCESS_KEY_ID="$(cat /run/secrets/pin-collector/s3-access-key-id)"
    RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY="$(cat /run/secrets/pin-collector/s3-secret-access-key)"
    export RCLONE_CONFIG_MINIO_ACCESS_KEY_ID RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY
    export RCLONE_CONFIG_GARAGE_TYPE=s3 RCLONE_CONFIG_GARAGE_PROVIDER=Other
    export RCLONE_CONFIG_GARAGE_ENDPOINT=http://garage:3900 RCLONE_CONFIG_GARAGE_REGION=us-east-1
    export RCLONE_CONFIG_GARAGE_FORCE_PATH_STYLE=true
    RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID="$(cat /run/secrets/pin-collector/garage-app-key-id)"
    RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY="$(cat /run/secrets/pin-collector/garage-app-secret)"
    export RCLONE_CONFIG_GARAGE_ACCESS_KEY_ID RCLONE_CONFIG_GARAGE_SECRET_ACCESS_KEY
    BUCKET=pin-collector-uploads
    case "$DIRECTION" in
      minio-to-garage) SRC=minio DST=garage ;;
      garage-to-minio) SRC=garage DST=minio ;;
      *) echo "unknown DIRECTION" >&2; exit 64 ;;
    esac
    list() { rclone lsjson -R --metadata --files-only "$1:$BUCKET" > "$2"; }
  sync.sh: |
    . /tools/remotes.sh
    # sync: the destination becomes identical, deletions included.
    rclone sync "$SRC:$BUCKET" "$DST:$BUCKET" --metadata --checksum --stats-one-line -v
    list "$SRC" /work/src1.json
    list "$DST" /work/dst1.json
  repair.sh: |
    . /tools/remotes.sh
    # Keys to force through again: compare's list (sync skips byte-identical objects whose
    # metadata differs) plus every key a byte comparison finds differing or missing on the
    # destination (sync can skip a same-size object whose checksums are not comparable).
    rclone check "$SRC:$BUCKET" "$DST:$BUCKET" --download --combined /work/check1.txt || true
    { cat /work/diff.txt; sed -n 's/^[*+] //p' /work/check1.txt; } | sort -u > /work/repair.txt
    if [ -s /work/repair.txt ]; then
      rclone copy "$SRC:$BUCKET" "$DST:$BUCKET" --files-from-raw /work/repair.txt --ignore-times --metadata -v
    fi
    # Bytes, both directions: must now be clean.
    rclone check "$SRC:$BUCKET" "$DST:$BUCKET" --download
    list "$SRC" /work/src2.json
    list "$DST" /work/dst2.json
  storage_compare.py: |
@storageCompareScript@
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: storage-migrate-minio-to-garage
  namespace: pin-collector
spec:
  # Suspended for good: only the template a hand-started Job is created from.
  suspend: true
  schedule: "0 0 31 2 *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 7200
      ttlSecondsAfterFinished: 1209600
      template:
        metadata:
          labels: { app: pin-collector-storage-migrate }
        spec:
          restartPolicy: Never
          nodeSelector:
            kubernetes.io/hostname: minas-tirith
          imagePullSecrets:
            - { name: pin-collector-registry }
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile: { type: RuntimeDefault }
          initContainers:
            - name: sync
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /tools/sync.sh]
              env: [{ name: DIRECTION, value: minio-to-garage }]
              securityContext: &storageMigrateSecurity
                allowPrivilegeEscalation: false
                capabilities: { drop: [ALL] }
                readOnlyRootFilesystem: true
              volumeMounts: &storageMigrateMounts
                - { name: tools, mountPath: /tools, readOnly: true }
                - { name: work, mountPath: /work }
                - { name: tmp, mountPath: /tmp }
                - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
            - name: compare
              image: "@apiImage@"
              imagePullPolicy: IfNotPresent
              command: [python, /tools/storage_compare.py, /work/src1.json, /work/dst1.json, --diff, /work/diff.txt, --report-only]
              securityContext: *storageMigrateSecurity
              volumeMounts: *storageMigrateMounts
            - name: repair
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /tools/repair.sh]
              env: [{ name: DIRECTION, value: minio-to-garage }]
              securityContext: *storageMigrateSecurity
              volumeMounts: *storageMigrateMounts
          containers:
            - name: verify
              image: "@apiImage@"
              imagePullPolicy: IfNotPresent
              command: [python, /tools/storage_compare.py, /work/src2.json, /work/dst2.json, --diff, /work/diff-final.txt]
              securityContext: *storageMigrateSecurity
              resources:
                requests: { cpu: 100m, memory: 128Mi }
                limits: { memory: 1Gi }
              volumeMounts: *storageMigrateMounts
          volumes:
            - name: tools
              configMap: { name: @storageToolsConfigName@ }
            - name: work
              emptyDir: { medium: Memory, sizeLimit: 256Mi }
            - name: tmp
              emptyDir: { medium: Memory, sizeLimit: 64Mi }
            - name: runtime-secret
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: s3-access-key-id, path: s3-access-key-id, mode: 0440 }
                  - { key: s3-secret-access-key, path: s3-secret-access-key, mode: 0440 }
                  - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
                  - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: storage-migrate-garage-to-minio
  namespace: pin-collector
spec:
  # Suspended for good: only the template a hand-started Job is created from.
  suspend: true
  schedule: "0 0 31 2 *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 7200
      ttlSecondsAfterFinished: 1209600
      template:
        metadata:
          labels: { app: pin-collector-storage-migrate }
        spec:
          restartPolicy: Never
          nodeSelector:
            kubernetes.io/hostname: minas-tirith
          imagePullSecrets:
            - { name: pin-collector-registry }
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile: { type: RuntimeDefault }
          initContainers:
            - name: sync
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /tools/sync.sh]
              env: [{ name: DIRECTION, value: garage-to-minio }]
              securityContext: &storageMigrateSecurity
                allowPrivilegeEscalation: false
                capabilities: { drop: [ALL] }
                readOnlyRootFilesystem: true
              volumeMounts: &storageMigrateMounts
                - { name: tools, mountPath: /tools, readOnly: true }
                - { name: work, mountPath: /work }
                - { name: tmp, mountPath: /tmp }
                - { name: runtime-secret, mountPath: /run/secrets/pin-collector, readOnly: true }
            - name: compare
              image: "@apiImage@"
              imagePullPolicy: IfNotPresent
              command: [python, /tools/storage_compare.py, /work/src1.json, /work/dst1.json, --diff, /work/diff.txt, --report-only]
              securityContext: *storageMigrateSecurity
              volumeMounts: *storageMigrateMounts
            - name: repair
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /tools/repair.sh]
              env: [{ name: DIRECTION, value: garage-to-minio }]
              securityContext: *storageMigrateSecurity
              volumeMounts: *storageMigrateMounts
          containers:
            - name: verify
              image: "@apiImage@"
              imagePullPolicy: IfNotPresent
              command: [python, /tools/storage_compare.py, /work/src2.json, /work/dst2.json, --diff, /work/diff-final.txt]
              securityContext: *storageMigrateSecurity
              resources:
                requests: { cpu: 100m, memory: 128Mi }
                limits: { memory: 1Gi }
              volumeMounts: *storageMigrateMounts
          volumes:
            - name: tools
              configMap: { name: @storageToolsConfigName@ }
            - name: work
              emptyDir: { medium: Memory, sizeLimit: 256Mi }
            - name: tmp
              emptyDir: { medium: Memory, sizeLimit: 64Mi }
            - name: runtime-secret
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: s3-access-key-id, path: s3-access-key-id, mode: 0440 }
                  - { key: s3-secret-access-key, path: s3-secret-access-key, mode: 0440 }
                  - { key: garage-app-key-id, path: garage-app-key-id, mode: 0440 }
                  - { key: garage-app-secret, path: garage-app-secret, mode: 0440 }
---
# backup-scripts
# ---------------------------------------------------------------------------------------
# Nightly backup to pelargir (docs/runbooks/minas-tirith/pin-collector-garage.md, "Phase E").
# A pg_dump plus a mirror of Garage made with the read-only backup key, every object the
# dump references checked, then a restic snapshot of both in /var/lib/pincollector-backup
# on pelargir (prepared by pelargir/pincollector-backup.nix).
# Every image here has an arm64 variant: pelargir is a Raspberry Pi.
# ---------------------------------------------------------------------------------------
apiVersion: v1
kind: ConfigMap
metadata:
  # Content-named (manifest-renderers.nix): a retried pod runs the scripts it started with.
  name: @backupScriptsConfigName@
  namespace: pin-collector
data:
@backupScripts@
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: pin-collector-backup
spec:
  capacity: { storage: 500Gi }
  accessModes: [ReadWriteOnce]
  persistentVolumeReclaimPolicy: Retain
  storageClassName: pin-collector-backup
  volumeMode: Filesystem
  claimRef: { namespace: pin-collector, name: backup-target }
  local:
    path: /var/lib/pincollector-backup
  nodeAffinity:
    required:
      nodeSelectorTerms:
        - matchExpressions:
            - { key: kubernetes.io/hostname, operator: In, values: [pelargir] }
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: backup-target
  namespace: pin-collector
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: pin-collector-backup
  volumeName: pin-collector-backup
  resources:
    requests: { storage: 500Gi }
---
# Stages, in order: list Garage (meta-1) → copy it into the mirror (copy-1) → pg_dump and
# extract the object keys it references (pg-dump) → list and copy again (meta-copy-2) →
# merge the listings and prove every reference is mirrored and listed (check) → restic
# snapshot, forget/prune, check (restic) → only then apply deletions to the mirror
# (mirror-prune). A manual run:
#   kubectl -n pin-collector create job --from=cronjob/backup backup-manual-<stamp>
# concurrencyPolicy covers only scheduled Jobs, so the pod also holds a kernel lock: the
# native sidecar `lock` (backup_lock.py) keeps flock() on /backup/.lock for the pod's life
# and every stage refuses unless it reports "acquired". A second pod, from any Job, sees
# "busy" and fails; the lock goes away with the pod, so nothing can go stale.
apiVersion: batch/v1
kind: CronJob
metadata:
  name: backup
  namespace: pin-collector
spec:
  suspend: @backupSuspended@
  schedule: "30 3 * * *"
  timeZone: Etc/UTC
  concurrencyPolicy: Forbid
  startingDeadlineSeconds: 3600
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      # A failed stage fails the pod and the Job starts a fresh one from meta-1: up to
      # three attempts. That is the retry for a reference the check finds missing (an
      # upload whose object was still being written), and for any transient failure.
      backoffLimit: 2
      # A replacement pod starts only once the failed one has fully terminated, so it never
      # finds its own predecessor still holding the lock.
      podReplacementPolicy: Failed
      activeDeadlineSeconds: 14400
      ttlSecondsAfterFinished: 604800
      template:
        metadata:
          labels: { app: pin-collector-backup }
        spec:
          restartPolicy: Never
          nodeSelector:
            kubernetes.io/hostname: pelargir
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              operator: Exists
              effect: NoSchedule
          enableServiceLinks: false
          automountServiceAccountToken: false
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            # The Secret files are 0440; fsGroup makes them readable. pelargir prepares the
            # target root as 10001, group-writable and setgid, so OnRootMismatch never walks
            # the repository.
            fsGroup: 10001
            fsGroupChangePolicy: OnRootMismatch
            seccompProfile: { type: RuntimeDefault }
          initContainers:
            # Native sidecar (restartPolicy: Always): runs for the pod's whole life. The
            # startupProbe holds back every later init container until the lock attempt has
            # resolved; the stages then read the verdict from lock-state.
            - name: lock
              image: python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
              imagePullPolicy: IfNotPresent
              restartPolicy: Always
              command: [python, /scripts/backup_lock.py, --target, /backup, --state, /run/lock-state/state]
              env:
                - { name: PYTHONDONTWRITEBYTECODE, value: "1" }
              securityContext: &backupSecurity
                allowPrivilegeEscalation: false
                capabilities: { drop: [ALL] }
                readOnlyRootFilesystem: true
              startupProbe:
                exec: { command: [test, -s, /run/lock-state/state] }
                periodSeconds: 1
                failureThreshold: 60
              resources:
                requests: { cpu: 10m, memory: 16Mi }
                limits: { memory: 64Mi }
              volumeMounts:
                - { name: scripts, mountPath: /scripts, readOnly: true }
                - { name: target, mountPath: /backup }
                - { name: lock-state, mountPath: /run/lock-state }
            - name: meta-1
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /scripts/backup_meta_1.sh]
              securityContext: *backupSecurity
              resources: &backupRcloneResources
                requests: { cpu: 100m, memory: 128Mi }
                limits: { memory: 1Gi }
              volumeMounts: &backupRcloneMounts
                - { name: scripts, mountPath: /scripts, readOnly: true }
                - { name: target, mountPath: /backup }
                - { name: tmp, mountPath: /tmp }
                - { name: garage-key, mountPath: /run/secrets/pin-collector, readOnly: true }
                - &backupLockState { name: lock-state, mountPath: /run/lock-state, readOnly: true }
            - name: copy-1
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /scripts/backup_copy_1.sh]
              securityContext: *backupSecurity
              resources: *backupRcloneResources
              volumeMounts: *backupRcloneMounts
            - name: pg-dump
              # The live server's image, so pg_dump matches the server's major version.
              image: pgvector/pgvector@sha256:a36250871de0833b8757561c72f2477ef1ddd1101afa4e617fb552e0de514c6b
              imagePullPolicy: IfNotPresent
              command: [bash, /scripts/backup_pg_dump.sh]
              securityContext: *backupSecurity
              resources:
                requests: { cpu: 100m, memory: 128Mi }
                limits: { memory: 1Gi }
              volumeMounts:
                - { name: scripts, mountPath: /scripts, readOnly: true }
                - { name: target, mountPath: /backup }
                - { name: tmp, mountPath: /tmp }
                - { name: work-secret, mountPath: /work-secret }
                - *backupLockState
                - { name: postgres-password, mountPath: /run/secrets/pin-collector, readOnly: true }
            - name: meta-copy-2
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /scripts/backup_meta_copy_2.sh]
              securityContext: *backupSecurity
              resources: *backupRcloneResources
              volumeMounts: *backupRcloneMounts
            - name: check
              image: python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
              imagePullPolicy: IfNotPresent
              command: [python, /scripts/backup_check.py, --work, /backup/work, --mirror, /backup/mirror, --target, /backup, --lock-state, /run/lock-state/state]
              env:
                - { name: HOME, value: /tmp }
                - { name: PYTHONDONTWRITEBYTECODE, value: "1" }
              securityContext: *backupSecurity
              resources:
                requests: { cpu: 100m, memory: 128Mi }
                limits: { memory: 1Gi }
              volumeMounts:
                - { name: scripts, mountPath: /scripts, readOnly: true }
                - { name: target, mountPath: /backup }
                - { name: tmp, mountPath: /tmp }
                - *backupLockState
            - name: restic
              image: restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76
              imagePullPolicy: IfNotPresent
              command: [sh, /scripts/backup_restic.sh]
              env:
                - { name: RESTIC_REPOSITORY, value: /backup/restic }
                - { name: RESTIC_PASSWORD_FILE, value: /run/secrets/pin-collector/backup-restic-password }
                - { name: RESTIC_CACHE_DIR, value: /tmp/restic-cache }
              securityContext: *backupSecurity
              resources:
                requests: { cpu: 100m, memory: 256Mi }
                limits: { memory: 2Gi }
              volumeMounts:
                - { name: scripts, mountPath: /scripts, readOnly: true }
                - { name: target, mountPath: /backup }
                - { name: tmp, mountPath: /tmp }
                - { name: restic-password, mountPath: /run/secrets/pin-collector, readOnly: true }
                - *backupLockState
          containers:
            - name: mirror-prune
              image: rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
              imagePullPolicy: IfNotPresent
              command: [sh, /scripts/backup_mirror_prune.sh]
              securityContext: *backupSecurity
              resources: *backupRcloneResources
              volumeMounts: *backupRcloneMounts
          volumes:
            - name: scripts
              configMap: { name: @backupScriptsConfigName@ }
            - name: target
              persistentVolumeClaim: { claimName: backup-target }
            # Disk-backed: restic's cache lives here.
            - name: tmp
              emptyDir: { sizeLimit: 2Gi }
            - name: work-secret
              emptyDir: { medium: Memory, sizeLimit: 1Mi }
            - name: lock-state
              emptyDir: { medium: Memory, sizeLimit: 1Mi }
            - name: garage-key
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: garage-backup-key-id, path: garage-backup-key-id, mode: 0440 }
                  - { key: garage-backup-secret, path: garage-backup-secret, mode: 0440 }
            - name: postgres-password
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: postgres-password, path: postgres-password, mode: 0440 }
            - name: restic-password
              secret:
                secretName: pin-collector-runtime
                defaultMode: 0440
                items:
                  - { key: backup-restic-password, path: backup-restic-password, mode: 0440 }
